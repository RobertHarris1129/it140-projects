# Project One Move-Between-Rooms Pseudocode

# Haunted Mansion Adventure

# Set the player's starting room.
SET currentRoom = "Entrance Hall"

# Begin the movement loop.
WHILE currentRoom is not "QUIT" AND currentRoom is not "GAME OVER"

    OUTPUT currentRoom
    OUTPUT "Enter a direction to move: North, South, East, West, or Quit."
    INPUT movementCommand

    IF movementCommand = "Quit"
        SET currentRoom = "QUIT"
        OUTPUT "Thanks for playing Haunted Mansion Adventure!"

    ELSE IF movementCommand is a valid direction from currentRoom
        SET currentRoom = the room connected in that direction
        OUTPUT "You moved to " + currentRoom

    ELSE
        OUTPUT "You cannot go that way. Please choose a valid direction."
    END IF

END WHILE

# End the game.
OUTPUT "Game over."
