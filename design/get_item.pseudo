# Project One Get-Item Pseudocode

# Haunted Mansion Adventure

START get_item

    # Identify the current room, its item, and inventory.
    SET currentRoom = player's current room
    SET roomItem = item available in currentRoom

    # Ask the player which item they want to collect.
    OUTPUT "Enter the name of the item you want to collect:"
    INPUT requestedItem

    # Check whether the requested item is available.
    IF roomItem exists AND requestedItem = roomItem

        # Add the item to inventory.
        ADD roomItem TO inventory
        SET roomItem = none

        OUTPUT "You collected " + requestedItem + "!"
        OUTPUT "The item has been added to your inventory."

    ELSE

        # The item is not available in this room.
        OUTPUT "That item is not available in this room."
        OUTPUT "Move to another room or try a different item."

    END IF

    # Return to the main gameplay loop.
    OUTPUT "Returning to Haunted Mansion Adventure."

END get_item
